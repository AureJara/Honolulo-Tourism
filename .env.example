# Copiar a .env y completar. Generar secretos con:  python -c "import secrets; print(secrets.token_hex(32))"
# Las contraseñas de base de datos deben ser alfanuméricas (se insertan en SQL y en una URL).

APP_ENV=production

# --- Secretos compartidos ---
JWT_SECRET_KEY=
INTERNAL_API_TOKEN=
WEB_SECRET_KEY=
COOKIE_SECURE=0            # 1 cuando se sirva por HTTPS

# --- PostgreSQL (un rol y una base por servicio) ---
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
WEATHER_DB_PASSWORD=
FORECAST_DB_PASSWORD=
CATALOG_DB_PASSWORD=

# --- Correo saliente (código de confirmación del registro) ---
# Con una cuenta de Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=tu_cuenta@gmail.com y SMTP_PASSWORD = una
# «contraseña de aplicación» de Google (requiere verificación en dos pasos). No uses la contraseña normal.
MAIL_FROM=Honolulo <tu_cuenta@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls     # starttls | ssl | none
CONTACT_EMAIL=contacto@honolulo-tingomaria.pe

# --- Ubicación única de Honolulo (RN01/RN02) ---
# Valor de referencia = Tingo María (9°17'44"S 75°59'51"O). Reemplazar por las coordenadas del predio.
LOCATION_LAT=-9.295556
LOCATION_LON=-75.9975

# --- Solo desarrollo local (python scripts/dev.py up) ---
# Las credenciales de las cuentas de prueba locales NO se publican en el repositorio: si las necesitas, quedan en
# .dev-credentials.local (ignorado por git). Para crear un administrador ver el README.
